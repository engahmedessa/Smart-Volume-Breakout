//@version=5
indicator("AHMED - Smart Volume & Breakout Risk", shorttitle="Volume & Risk", overlay=false)

volSmaLength = input.int(20, title="Volume SMA Length")
atrLength = input.int(14, title="ATR Length")
bodyThreshold = input.float(0.85, title="Body Control Threshold (0.85 = 85%)")
sizeMultiplier = input.float(1.5, title="Price Momentum Multiplier")

atr = ta.atr(atrLength)
candleSize = high - low
bodySize = math.abs(close - open)

isDominantBody = candleSize == 0 ? false : (bodySize / candleSize) >= bodyThreshold
isOversized = candleSize > (atr * sizeMultiplier)

volSma = ta.sma(volume, volSmaLength)
isHighVol = volume > volSma

bearishBreakRisk = close < open and isDominantBody and isOversized and isHighVol
bullishBreakRisk = close > open and isDominantBody and isOversized and isHighVol

plot(volume, style=plot.style_columns, color=color.new(color.gray, 70), title="Total Volume")
plot(volSma, color=color.new(color.white, 50), title="Volume SMA")

volColor = bearishBreakRisk ? color.new(color.red, 20) : bullishBreakRisk ? color.new(color.green, 20) : na
plot(volume, style=plot.style_columns, color=volColor, title="Potential Breakout Volume")

plotshape(bearishBreakRisk ? volume : na, style=shape.triangledown, location=location.absolute, color=color.red, size=size.small, title="Bearish Break Risk")
plotshape(bullishBreakRisk ? volume : na, style=shape.triangleup, location=location.absolute, color=color.green, size=size.small, title="Bullish Break Risk")
